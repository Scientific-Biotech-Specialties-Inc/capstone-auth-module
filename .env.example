# =============================================================
#  Docker Compose — Environment Variables Template
#  Copy this file to .env and fill in your actual values.
#  NEVER commit .env to version control.
# =============================================================

# --- Application ---
APP_NAME=SBSI
APP_ENV=local
APP_DEBUG=true
# Internal Encryption Key used for secure communication between frontend and backend
# Must be a secure, unique 32-character string
INTERNAL_ENCRYPTION_KEY=

# --- Database ---
DB_CONNECTION=mysql
DB_HOST=mysql-db
DB_PORT=3306
DB_DATABASE=capstone_auth
DB_USERNAME=capstone_user
DB_PASSWORD=capstone_password

# MySQL container (must match DB_ values above)
MYSQL_ROOT_PASSWORD=capstone_password
MYSQL_DATABASE=capstone_auth

# --- Redis ---
REDIS_HOST=auth-redis

# --- Mail (e.g. Mailtrap sandbox credentials) ---
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# --- Transactional Email / Brevo ---
EMAIL_NOTIFICATIONS_PROVIDER=brevo
BREVO_BASE_URL=https://api.brevo.com/v3
BREVO_API_KEY=
BREVO_WEBHOOK_SECRET=
BREVO_WEBHOOK_SECRET_HEADER=X-Brevo-Webhook-Secret
BREVO_TEMPLATE_WELCOME_TEMP_PASSWORD=
BREVO_TEMPLATE_PASSWORD_RESET=
BREVO_TEMPLATE_EMAIL_VERIFICATION=
BREVO_TEMPLATE_PASSWORD_CHANGED_CONFIRMATION=
